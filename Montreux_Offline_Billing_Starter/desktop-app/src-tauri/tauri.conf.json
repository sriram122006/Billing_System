{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Montreux Clothing Billing",
  "version": "0.1.0",
  "identifier": "com.montreux.clothingbilling",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Montreux Clothing \u2014 Offline Billing",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline billing and inventory for clothing retail",
    "longDescription": "Local-first desktop billing application with transactional SQLite storage."
  }
}
