{
  "name": "montreux-billing",
  "version": "1.0.0",
  "description": "Montreux Clothing — Offline Billing Desktop Application",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "test:smoke": "npm run build:electron && rm -f /tmp/montreux-phase1-smoke.db /tmp/montreux-phase1-smoke.db-shm /tmp/montreux-phase1-smoke.db-wal && MONTREUX_SMOKE_DB=/tmp/montreux-phase1-smoke.db ./node_modules/electron/dist/electron --no-sandbox dist-electron/phase1-smoke.js",
    "test:backup-restore": "npm run build:electron && rm -f /tmp/montreux-backup-source.db /tmp/montreux-backup-source.db-shm /tmp/montreux-backup-source.db-wal /tmp/montreux-backup-target.db /tmp/montreux-backup-target.db-shm /tmp/montreux-backup-target.db-wal /tmp/montreux-backup-target.db.pre-restore-smoke.json && MONTREUX_SOURCE_DB=/tmp/montreux-backup-source.db MONTREUX_TARGET_DB=/tmp/montreux-backup-target.db ./node_modules/electron/dist/electron --no-sandbox dist-electron/backup-restore-smoke.js",
    "replace:inventory": "npm run build:electron && CONFIRM_REPLACE_INVENTORY=YES ./node_modules/electron/dist/electron --no-sandbox dist-electron/replace-inventory.js",
    "package": "npm run build && electron-builder",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.montreux.billing",
    "productName": "Montreux Billing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
